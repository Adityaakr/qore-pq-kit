    "@cosmjs/proto-signing": "^0.39.0",
    "cosmjs-types": "^0.11.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  }
